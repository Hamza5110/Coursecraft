PORT=5000
MONGO_URI=your_mongodb_connection_string
# Generate with: openssl rand -hex 32 (must be >= 32 chars)
JWT_SECRET=replace_with_openssl_rand_hex_32_output_here
# Must match the Vite origin exactly (used for CORS + cookie credentials)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Required in production (password-reset emails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Coursecraft <noreply@example.com>"
